{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false,
    "incremental": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/app/.well-known/**/*.ts",
    "e2e/**/*.ts",
    ".next/types/**/*.ts",
    "playwright.config.ts",
    "next.config.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
