# Admin console (SPEC §26). Copy to .env.local for local development.
# development | staging | production. The local key wrapper is refused outside development.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Comma-separated. Only these emails can ever sign in or be created as admins.
ADMIN_ALLOWED_EMAILS=admin@example.test
# Optional comma-separated client IPs.
ADMIN_IP_ALLOWLIST=
# local (development/test only) or kms (production, ADR 0008)
KEY_WRAPPER=local
# base64 of 32 random bytes; local wrapper only. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCAL_MASTER_KEY=
KMS_MASTER_KEY_ID=
AWS_REGION=
